{
  "name": "claimlint",
  "version": "0.1.1",
  "description": "Adversarial verification of binary externally resolved claim semantics",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "claimlint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "claimlint": "tsx src/cli.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "fast-check": "^4.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^10.14.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
